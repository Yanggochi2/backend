# 복사해서 사용: cp .env.example .env  (.env는 git에 올리지 않는다)
# docker compose가 이 값을 읽는다. .env가 없으면 compose.yaml의 기본값(아래와 같음)으로 뜬다

# PostgreSQL 계정. 배포 환경에서는 반드시 강한 비밀번호로 바꿀 것
# (이미 만들어진 DB 볼륨에는 바뀐 값이 적용되지 않는다 → docker compose down -v 후 다시 띄우기)
POSTGRES_DB=nurs
POSTGRES_USER=nurs
POSTGRES_PASSWORD=nurs

# 쿠키 Secure 속성. http 로컬 개발은 false, HTTPS 배포는 true
COOKIE_SECURE=false

# 호스트에서 API를 열 포트 (http://localhost:8000/docs)
API_PORT=8000

# 근무 전날 리마인드 주기(초). 비우면 매일 18시(KST). 테스트할 때만 짧게
REMINDER_EVERY_SECONDS=
